{
    "name": "yireo/magento2-auto-invoice-zero-subtotal-orders",
    "version": "2.0.0",
    "description": "Automatically invoice orders placed with the free payment method and a zero grand total",
    "type": "magento2-module",
    "require": {
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.0",
        "magento/module-payment": "^100.0",
        "magento/module-sales": "^103.0",
        "magento/module-store": "^101.0",
        "php": ">=8.1",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.5",
        "yireo/magento2-integration-test-helper": "~0.0"
    },
    "license": "OSL-3.0",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Yireo\\AutoInvoiceZeroSubtotalOrders\\": ""
        }
