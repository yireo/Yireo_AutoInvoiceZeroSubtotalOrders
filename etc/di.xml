<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Yireo\AutoInvoiceZeroSubtotalOrders\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/yireo_auto_invoice_zero_subtotal_orders.log</argument>
        </arguments>
    </virtualType>

    <virtualType name="Yireo\AutoInvoiceZeroSubtotalOrders\Logger\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">yireo_auto_invoice_zero_subtotal_orders</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Yireo\AutoInvoiceZeroSubtotalOrders\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Yireo\AutoInvoiceZeroSubtotalOrders\Cron\AutoInvoice">
        <arguments>
            <argument name="logger" xsi:type="object">Yireo\AutoInvoiceZeroSubtotalOrders\Logger\Logger</argument>
        </arguments>
    </type>
</config>
